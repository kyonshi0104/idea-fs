{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IdeaFS",
  "version": "0.1.0",
  "identifier": "com.kyonshi.ideafs",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IdeaFS",
        "width": 1290,
        "height": 750
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBNTFBN0ZGRERCQTc4MjgKUldRb2VMcmQvNmRSbXZNdWk3MnF1MDFneHRvaElpVzBtdjRHSlY3U3NBSHFpdlN3UDl6UEtUNGcK",
      "endpoints": [
        "https://github.com/kyonshi0104/idea-fs/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./nsis/installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
